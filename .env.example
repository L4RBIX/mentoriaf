NEXT_PUBLIC_API_BASE_URL=

# Supabase backend. Leave blank for local demo backend mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=writeoff-photos
DATABASE_URL=

# Gemini Vision. Optional; duplicate and metadata checks still run if absent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VISION_PROVIDER=gemini
VISION_TIMEOUT_MS=30000

# iiko integration.
IIKO_MODE=sandbox
IIKO_API_KEY=
IIKO_BASE_URL=
IIKO_LOGIN=
IIKO_PASSWORD=
IIKO_TOKEN_CACHE_ENABLED=true

# Demo scripts.
DEMO_BASE_URL=http://localhost:3000
AUTO_REJECT_STRONG_DUPLICATE=false
